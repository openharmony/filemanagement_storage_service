import("//build/config/features.gni")
import("//build/test.gni")
import("//foundation/filemanagement/storage_service/storage_service_aafwk.gni")

ohos_fuzztest("DiskUtilsCdEjectFuzzTest") {
  module_out_path = "storage_service/storage_service"
  fuzz_config_file = "${storage_service_path}/test/fuzztest/diskutilscdeject_fuzzer"
  include_dirs = [
    "${storage_daemon_path}/include",
    "${storage_daemon_path}/common/include",
  ]
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  sources = [ "${storage_service_path}/test/fuzztest/diskutilscdeject_fuzzer/diskutils_cdeject_fuzzer.cpp" ]
  defines = [
    "STORAGE_LOG_TAG = \"StorageDaemon\"",
    "LOG_DOMAIN = 0xD004301",
    "KMSG_LOG",
  ]
  configs = [
    "${storage_daemon_path}:storage_daemon_config",
    "${storage_service_path}/test/fuzztest:storage_daemon_fuzz_no_lto",
  ]
  deps = [
    "${storage_daemon_path}/crypto:libsdcrypto",
    "${storage_daemon_path}:storage_common_utils",
    "${storage_daemon_path}:storage_daemon_ipc",
    "${storage_interface_path}/innerkits/storage_manager/native:storage_manager_sa_proxy",
  ]
  external_deps = [
    "ability_base:base",
    "ability_base:want",
    "ability_base:zuri",
    "app_file_service:fileshare_native",
    "app_file_service:fileuri_native",
    "app_file_service:sandbox_helper_native",
    "bounds_checking_function:libsec_shared",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "cJSON:cjson",
    "config_policy:configpolicy_util",
    "c_utils:utils",
    "crypto_framework:crypto_framework_lib",
    "zlib:shared_libz",
    "eventhandler:libeventhandler",
    "hicollie:libhicollie",
    "hilog:libhilog",
    "hisysevent:libhisysevent",
    "hitrace:hitrace_meter",
    "huks:libhukssdk",
    "init:libbegetutil",
    "ipc:ipc_single",
    "json:nlohmann_json_static",
    "openssl:libcrypto_shared",
    "os_account:os_account_innerkits",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
  ]
  if (enable_disk_manager) {
    defines += [ "DISK_MANAGER" ]
    sources += [
      "${storage_daemon_path}/disk_manager/src/disk/disk_utils.cpp",
      "${storage_daemon_path}/disk_manager/src/disk/scan_device.cpp",
      "${storage_daemon_path}/disk_manager/src/volume/volume_utils.cpp",
      "${storage_daemon_path}/disk_manager/src/volume/volume_operator_factory.cpp",
      "${storage_daemon_path}/disk_manager/src/volume/udf_operator.cpp",
      "${storage_daemon_path}/disk_manager/src/volume/iso9660_operator.cpp",
      "${storage_daemon_path}/disk_manager/src/volume/exfat_operator.cpp",
      "${storage_daemon_path}/disk_manager/src/volume/ntfs_operator.cpp",
      "${storage_daemon_path}/disk_manager/src/volume/vfat_operator.cpp",
      "${storage_daemon_path}/disk_manager/src/volume/hmfs_operator.cpp",
      "${storage_daemon_path}/disk_manager/src/volume/ext4_operator.cpp",
      "${storage_daemon_path}/disk_manager/src/volume/ivolume_operator.cpp",
    ]
    external_deps += [ "disk_manager:disk_manager_innerkits" ]
  }
  if (storage_service_external_storage_manager) {
    sources += [
      "${storage_daemon_path}/volume/src/process.cpp",
    ]
  }
}

group("fuzztest") {
  testonly = true
  deps = [ ":DiskUtilsCdEjectFuzzTest" ]
}
